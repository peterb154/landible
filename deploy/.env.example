# landible-deploy shim env. Copy to /opt/landible/deploy/.env (chmod 600).
# Never commit .env. This is the shim's OWN env, separate from compose/.env
# and mcp/.env.

# Bearer token for POST /api/deploy and the /api/webhooks CRUD
# (landible-mcp presents it too). Any long random string: openssl rand -hex 24
DEPLOY_TOKEN=

# Shared secret the pollers in mcp/systemd send as an `Authorization` header on
# POST /api/events/books, so nothing else on the LAN can spoof events.
# openssl rand -hex 24
WEBHOOK_INBOUND_SECRET=
