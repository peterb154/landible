# landible — copy to .env (gitignored) and fill in. compose/.env symlinks here.

# ---- Host -------------------------------------------------------------------
TZ=America/Chicago
# uid/gid every container writes as. In an unprivileged LXC, 1000 inside maps
# to 101000 on the Proxmox host — chown host dirs to that.
PUID=1000
PGID=1000
# The LXC-side path of the single bind mount holding books/, appdata/ and
# libation-staging/. ONE filesystem, or the ebook<->torrent hardlinks break.
DATA_ROOT=/data

# ---- Secrets ----------------------------------------------------------------
# qbittorrent-mam WebUI password (user `admin`). `openssl rand -hex 16`, then
# set via the qBt API (docs/runbook.md). No subnet whitelist, so every caller
# needs it.
QBT_MAM_WEBUI_PASSWORD=

# Chaptarr web UI password (user `admin`). `openssl rand -hex 16`;
# scripts/chaptarr_setup.py applies it (its auth defaults to none).
CHAPTARR_PASSWORD=
