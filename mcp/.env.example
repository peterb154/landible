# landible-mcp runtime config. Copy to .env (chmod 600); it is gitignored.
# Defaults assume the server runs on the same host as the stack.

# ---- Server ----
MCP_HOST=0.0.0.0
MCP_PORT=8087
# Secret the gateway forwards as X-MCP-Secret; guards the write tools.
# Blank = no check (local dev only).
MCP_SHARED_SECRET=

# ---- Deploy shim (webhook CRUD for the landible_webhook_* tools) ----
DEPLOY_HEALTH_URL=http://localhost:8090
# Same value as the shim's DEPLOY_TOKEN.
DEPLOY_TOKEN=

# ---- Chaptarr (grabber) ----
# Key: Chaptarr config.xml <ApiKey>
CHAPTARR_URL=http://localhost:8789
CHAPTARR_API_KEY=

# ---- qbittorrent-mam (read-only: the unsatisfied-torrent guard) ----
QBT_MAM_URL=http://localhost:8081
QBT_MAM_USER=admin
QBT_MAM_PASSWORD=

# ---- Audiobookshelf ----
# API key of a NON-admin ABS user (Settings -> API Keys).
ABS_URL=http://localhost:13378
ABS_API_KEY=
# Folder of the Ebooks library inside the ABS container.
ABS_EBOOK_FOLDER=/ebooks
# Default e-reader device name (Settings -> Email). Blank = callers must pass one.
ABS_KINDLE_DEVICE=

# ---- MAM ----
# book_request refuses at this many torrents not yet seeded 72 h.
# Keep it below MAM's own unsat_limit (20 for new members).
MAM_UNSATISFIED_CAP=15
# Join date (YYYY-MM-DD) for landible_mam_stats' Power User date. Blank = unknown.
MAM_JOINED=
